<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>BUG_GBCompat</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>  <!-- versions are set in src/Plugin.cs -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>  <!-- the publicizer needs it to reach private members -->
    <!-- Override for your install: dotnet build -c Release "-p:DSPGamePath=..." "-p:BepInExCorePath=..." "-p:PluginsPath=..." -->
    <DSPGamePath Condition="'$(DSPGamePath)' == ''">D:\Games\Dyson Sphere Program</DSPGamePath>
    <BepInExCorePath Condition="'$(BepInExCorePath)' == ''">$(APPDATA)\com.kesomannen.gale\dyson-sphere-program\profiles\Default\BepInEx\core</BepInExCorePath>
    <PluginsPath Condition="'$(PluginsPath)' == ''">$(APPDATA)\com.kesomannen.gale\dyson-sphere-program\profiles\Default\BepInEx\plugins</PluginsPath>
    <ManagedPath>$(DSPGamePath)\DSPGAME_Data\Managed</ManagedPath>
    <!-- GenesisBook's preloader adds fields and enum values to the game; set DumpAssemblies = true in BepInEx.cfg [Preloader.Entrypoint], start the game once, then build. -->
    <PatchedAssemblyCSharp Condition="'$(PatchedAssemblyCSharp)' == ''">$(BepInExCorePath)\..\DumpedAssemblies\Assembly-CSharp.dll</PatchedAssemblyCSharp>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(PatchedAssemblyCSharp)" Private="false" Publicize="true" />
    <Reference Include="$(ManagedPath)\UnityEngine*.dll" Private="false" />
    <Reference Include="$(BepInExCorePath)\BepInEx.dll" Private="false" />
    <Reference Include="$(BepInExCorePath)\0Harmony.dll" Private="false" />
    <Reference Include="$(PluginsPath)\HiddenCirno-GenesisBook\ProjectGenesis.dll" Private="false" Publicize="true" />
    <Reference Include="$(PluginsPath)\CommonAPI-CommonAPI\CommonAPI.dll" Private="false" />
    <Reference Include="$(PluginsPath)\CommonAPI-DSPModSave\DSPModSave.dll" Private="false" />
    <Reference Include="$(PluginsPath)\nebula-NebulaMultiplayerModApi\NebulaAPI.dll" Private="false" />
    <Reference Include="$(PluginsPath)\xiaoye97-LDBTool\LDBTool.dll" Private="false" />
  </ItemGroup>
</Project>
